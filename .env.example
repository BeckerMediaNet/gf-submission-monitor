# ============================================================
# Gravity Forms Submission Monitor — per-site configuration
# Copy this file to ".env" in the same directory and fill in
# the values for THIS server/site. Never commit the real .env
# to git or share it — it contains your Slack webhook URL.
# ============================================================

# Slack Incoming Webhook URL for the channel that should receive alerts.
# Create one at https://api.slack.com/messaging/webhooks (or ask your
# Slack admin for the webhook for #site-alerts or similar).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/HERE

# Friendly label used in Slack messages so you know which site fired.
SITE_LABEL="Client Name - example.com"

# Absolute path to the WordPress install (folder containing wp-config.php)
WP_PATH=/var/www/html

# Path to the wp-cli binary. Leave as "wp" if it's on PATH for the cron
# user, otherwise use the full path (find it with: which wp)
WP_CLI_BIN=wp

# Linux user that owns the WordPress files (used to run wp-cli with the
# correct permissions). Common values: www-data, wp-user, ubuntu.
WP_USER=www-data

# How many hours back to look for Gravity Forms submissions.
LOOKBACK_HOURS=24

# Minimum hours between repeat "still no submissions" Slack alerts,
# so the channel isn't spammed every time the cron job runs.
ALERT_COOLDOWN_HOURS=6

# Optional: comma-separated Gravity Forms form IDs to check (e.g. "1,3,7").
# Leave blank to check ALL active forms on the site.
FORM_IDS=

# Where to keep the small state/log files this script writes.
# Defaults to a "state" and "logs" folder next to this script.
STATE_DIR=
